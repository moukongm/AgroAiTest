<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_editprofile"
    android:background="@drawable/bg_main_newheader"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_information_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="#60ffffff"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_etp_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_information_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编辑资料"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/cv_information_back"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cv_information_back" />
        <!--  内容区域  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cons_information_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="97dp"
            android:background="@drawable/shape_stp_bgmain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!--  头像  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/avatar_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                app:cardBackgroundColor="#CCFFFFFF"
                android:layout_marginTop="25dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="1dp"
                app:cardCornerRadius="14.1dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginLeft="13dp"
                    android:text="头像"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="right">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_information_settitle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginRight="16dp"
                        android:backgroundTint="#60ffffff"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/iv_arrow1"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id = "@+id/iv_settingTitle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_etp_settitle"
                                android:scaleType="centerCrop"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                            </ImageView>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <ImageView
                        android:id="@+id/iv_arrow1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ic_etp_tosettitle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/cv_information_settitle"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!--  昵称  -->
            <!--  绑定手机号  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/nickname_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#CCFFFFFF"
                app:cardCornerRadius="14.1dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/avatar_container"
                tools:layout_editor_absoluteX="20dp">

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginLeft="13dp"
                    android:text="昵称"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_nickname_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginRight="24dp"
                    android:text="王建军"
                    android:textColor="#6C6C6C"
                    android:textSize="13.3sp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/phone_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="11.5dp"
                app:cardBackgroundColor="#CCFFFFFF"
                android:layout_marginBottom="1dp"
                android:background="#FFFFFF"
                app:cardElevation="0dp"
                app:cardCornerRadius="14.1dp"
                app:layout_constraintTop_toBottomOf="@+id/nickname_container">

                <TextView
                    android:id="@+id/tv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginLeft="13dp"
                    android:text="绑定手机号"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_phone_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginRight="24dp"
                    android:text="18888888888"
                    android:textColor="#6C6C6C"
                    android:textSize="13.3sp" />
            </androidx.cardview.widget.CardView>
            <!--  关注的作物  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/crop_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12.5dp"
                android:background="#FFFFFF"
                app:cardCornerRadius="14.1dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CCFFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/phone_container">

                <TextView
                    android:id="@+id/tv_crop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginLeft="13dp"
                    android:text="关注的作物"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_crop_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|end"
                    android:layout_marginRight="24dp"
                    android:text="水稻"
                    android:textColor="#6C6C6C"
                    android:textSize="13.3sp" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/password_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="11.5dp"
                android:layout_marginBottom="1dp"
                android:background="#FFFFFF"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CCFFFFFF"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14.1dp"
                app:layout_constraintTop_toBottomOf="@+id/crop_container">

                <TextView
                    android:id="@+id/tv_newpassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginLeft="13dp"
                    android:text="密码"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_newpassword_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginRight="24dp"
                    android:text="***"
                    android:textColor="#6C6C6C"
                    android:textSize="13.3sp" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

