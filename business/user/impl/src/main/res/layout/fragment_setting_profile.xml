<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_mainp_header">


    <androidx.cardview.widget.CardView
        android:id="@+id/cv_settingprofile_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="43dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="#60ffffff"
        app:cardElevation="0dp"
        app:cardCornerRadius="24dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="11dp"
                android:layout_height="19dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:background="@drawable/ic_etp_back">

            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="#FFFFFF"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cv_settingprofile_back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cv_settingprofile_back" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/set_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="87.5dp"
        android:background="@drawable/shape_stp_bgmain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/set_message"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="39.1dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_marginLeft="11.6dp"
                    android:text="系统消息通知"
                    android:textColor="#333333"
                    android:textSize="16dp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintRight_toRightOf="parent"
                    android:layout_marginRight="25dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:showText="false"
                    android:thumb="@drawable/bg_setting_switchthumb"
                    app:track="@drawable/bg_setting_switchtrack"
                    app:trackTint="@null"
                    android:thumbTint="@null"
                    app:thumbTint="@null"
                    >

                </androidx.appcompat.widget.SwitchCompat>

            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/set_about"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="6.6dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toBottomOf="@+id/set_message">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="14dp"
                android:text="关于我们"
                android:textColor="#333333"
                android:textSize="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="20.8dp"
                android:src="@drawable/ic_etp_tosettitle" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/set_tickle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="6.6dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toBottomOf="@+id/set_about">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="14dp"
                android:text="我要反馈"
                android:textColor="#333333"
                android:textSize="16dp"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="25dp"
                android:src="@drawable/ic_etp_tosettitle"  />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/set_power"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="6.6dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toBottomOf="@+id/set_tickle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="14dp"
                android:text="系统权限"
                android:textColor="#333333"
                android:textSize="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="25dp"
                android:src="@drawable/ic_etp_tosettitle"  />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/set_agreement"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="6.6dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toBottomOf="@+id/set_power">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="14dp"
                android:text="用户协议"
                android:textColor="#333333"
                android:textSize="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="25dp"
                android:src="@drawable/ic_etp_tosettitle"  />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/set_policy"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="6.6dp"
            android:layout_marginRight="16dp"
            app:cardCornerRadius="14.1dp"
            app:layout_constraintTop_toBottomOf="@+id/set_agreement">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginLeft="14dp"
                android:text="隐私政策"
                android:textColor="#333333"
                android:textSize="16dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="25dp"
                android:src="@drawable/ic_etp_tosettitle"  />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id = "@+id/btn_setting_unlogin"
            android:layout_width="match_parent"
            android:layout_height="41.6dp"
            android:layout_marginLeft="21.6dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/shape_enp_ok"
            android:gravity="center"
            android:text="退出登录"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/set_policy"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>