<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:background="@drawable/bg_mainp_header"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
       >

        <androidx.cardview.widget.CardView
            android:layout_width="66.9dp"
            android:layout_height="66.9dp"
            android:layout_marginTop="79.1dp"
            app:cardCornerRadius="33.45dp"
            app:cardElevation="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id = "@+id/user_head">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_etp_settitle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="用户2759"
            android:textColor="@android:color/white"
            android:textSize="23.3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_head" />

        <TextView
            android:id="@+id/user_fanscnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="71.6dp"
            android:layout_marginTop="219.1dp"
            android:text="8"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="他的收藏"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            app:layout_constraintLeft_toLeftOf="@+id/user_fanscnt"
            app:layout_constraintRight_toRightOf="@+id/user_fanscnt"
            app:layout_constraintTop_toBottomOf="@+id/user_fanscnt" />

        <TextView
            android:id="@+id/user_historycnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="219.1dp"
            android:text="16"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="识别记录"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            app:layout_constraintLeft_toLeftOf="@+id/user_historycnt"
            app:layout_constraintRight_toRightOf="@+id/user_historycnt"
            app:layout_constraintTop_toBottomOf="@id/user_historycnt" />
        <ImageView

            android:clickable="true"
            android:focusable="true"
            android:id="@+id/mine_set"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="54.1dp"
            android:layout_marginRight="60.8dp"
            android:src="@drawable/ic_mainp_setting"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/mine_share"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="54.1dp"
            android:layout_marginRight="23.75dp"
            android:src="@drawable/ic_mainp_toother"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:clickable="true"
            android:focusable="true"
            android:id = "@+id/iv_editprofile"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginTop="227.5dp"
            android:layout_marginRight="26.6dp"
            android:src="@drawable/ic_mainp_toedit"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/user_post"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="273.3dp"
            android:background="@drawable/shape_stp_bgmain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22.5dp"
                android:layout_marginTop="21.6dp"
                android:alpha="0.9"
                android:text="我的帖子"
                android:textColor="@android:color/black"
                android:textSize="17.5sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/user_post_rec"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="64.1dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>