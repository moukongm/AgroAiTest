<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部用户信息区域 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_user_head"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="59.1dp"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="0dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/user_head"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_etp_settitle" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="用户2759"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cv_user_head" />

                <TextView
                    android:id="@+id/user_fanscnt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="71.6dp"
                    android:layout_marginTop="220dp"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_fans_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="收藏"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:layout_constraintLeft_toLeftOf="@+id/user_fanscnt"
                    app:layout_constraintRight_toRightOf="@+id/user_fanscnt"
                    app:layout_constraintTop_toBottomOf="@+id/user_fanscnt" />

                <TextView
                    android:id="@+id/user_historycnt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="220dp"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_history_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="识别记录"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:layout_constraintLeft_toLeftOf="@+id/user_historycnt"
                    app:layout_constraintRight_toRightOf="@+id/user_historycnt"
                    app:layout_constraintTop_toBottomOf="@id/user_historycnt" />

                <ImageView
                    android:id="@+id/mine_set"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:layout_marginTop="24.1dp"
                    android:layout_marginRight="67dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_mainp_setting"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/mine_share"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:layout_marginTop="24.1dp"
                    android:layout_marginRight="23.75dp"
                    android:src="@drawable/ic_mainp_toother"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_editprofile"
                    android:layout_width="110dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="217dp"
                    android:layout_marginRight="26.6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_mainp_toedit"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 帖子列表区域 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/posts_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/shape_mainp_bgmain"
                >

                <TextView
                    android:id="@+id/tv_my_posts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:text="我的帖子"
                    android:textColor="#1A1A1A"
                    android:textSize="23sp"
                    android:textStyle="bold"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/user_post_rec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintVertical_bias="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_my_posts" />
                <View
                    android:id="@+id/mes_view2"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:layout_constraintTop_toBottomOf="@+id/user_post_rec"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                </View>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
