<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id = "@+id/cons_mainitem"
    android:background="@drawable/cv_itemmes_main"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:layout_height="62dp">

    <!-- 头像：垂直居中 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_avatar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="27.5dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id = "@+id/cons_avater"
            android:layout_width="match_parent"
            android:background="@drawable/ic_mes_all"
            android:layout_height="match_parent">
            <ImageView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:id="@+id/iv_avatar"
                android:layout_width="25dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_mes_allic"
                />
            <ImageView
                android:id = "@+id/iv_plavatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>

    <!-- 右侧：时间 + 缩略图 -->
    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="1.0">

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#BFBFBF"
            android:textSize="12sp"
            android:text="36分钟前"
            android:layout_gravity="bottom"
          />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/thumb_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
          >

            <androidx.cardview.widget.CardView
                android:id="@+id/card_thumb"
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/iv_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/dot_thumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:scaleType="centerInside"
                android:background="@drawable/ic_mes_nosee"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="18dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="通知"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="100dp"
        android:maxLines="1"
        android:textColor="#8C8C8C"
        android:textSize="13sp"
        android:text="欢迎使用植小保APP"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
         />


</androidx.constraintlayout.widget.ConstraintLayout>
