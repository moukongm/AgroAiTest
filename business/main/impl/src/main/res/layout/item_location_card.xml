<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- 定位区域卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_city_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 当前选择行 -->
        <LinearLayout
            android:id="@+id/llCurrentSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前选择："
                android:textSize="13sp"
                android:textColor="#6C6C6C"/>
            <TextView
                android:id="@+id/tvCurrentCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="#6C6C6C"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#F0F0F0" />

        <!-- 当前定位行 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tvNowLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="当前定位"
                android:textColor="#6C6C6C"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <TextView
                android:id="@+id/tvLocationCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNowLocation"
                android:text=""
                android:textColor="#333333"
                android:textSize="18sp" />
            <ImageView
                android:id="@+id/ivLocationIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_redingwei"
                app:layout_constraintEnd_toStartOf="@+id/tvRelocate"
                app:layout_constraintTop_toTopOf="@+id/tvRelocate"/>

            <TextView
                android:id="@+id/tvRelocate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重新定位"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/tvLocationCity"
                android:textColor="#00AAD0"
                android:textSize="15sp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- 推荐城市标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="16dp"
        android:text="推荐城市"
        android:textColor="#333333"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 热门城市 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHotCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="16dp"
        android:background="#F0F0F0" />

</LinearLayout>
