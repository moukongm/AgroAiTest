            </LinearLayout>

            <!-- 保存修改按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_changes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="保存修改"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:background="@drawable/bg_confirm_label"
                app:backgroundTint="@null"
                app:cornerRadius="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_plant_info_cards" />

            <!-- 种植管理 -->
            <TextView
                android:id="@+id/tv_plant_manage_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_save_changes"
                android:layout_marginTop="20dp"
                android:text="种植管理"
                android:textColor="#0D1014"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Tab标题栏 - 浇水/施肥/用药/笔记 -->
            <LinearLayout
                android:id="@+id/ll_tab_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_container"
                android:padding="4dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_plant_manage_label">

                <!-- Tab标签行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@android:color/transparent">

                    <!-- 浇水标签 -->
                    <LinearLayout
                        android:id="@+id/tab_water"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_tab_selected">

                        <ImageView
                            android:id="@+id/iv_icon_water"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_plant_water"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_tab_water"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="浇水"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tab_text_color" />
                    </LinearLayout>

                    <!-- 施肥标签 -->
                    <LinearLayout
                        android:id="@+id/tab_fertilize"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@android:color/transparent">

                        <ImageView
                            android:id="@+id/iv_icon_fertilize"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_plant_fertilize"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_tab_fertilize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="施肥"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tab_text_color" />
                    </LinearLayout>

                    <!-- 用药标签 -->
                    <LinearLayout
                        android:id="@+id/tab_medicine"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@android:color/transparent">

                        <ImageView
                            android:id="@+id/iv_icon_medicine"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_plant_medicine"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_tab_medicine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="用药"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tab_text_color" />
                    </LinearLayout>

                    <!-- 笔记标签 -->
                    <LinearLayout
                        android:id="@+id/tab_note"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@android:color/transparent">

                        <ImageView
                            android:id="@+id/iv_icon_note"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_plant_note"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_tab_note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="笔记"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/tab_text_color" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 日历和按钮卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cd_calendar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_tab_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 日历头部：月份选择 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp">

                        <ImageView
                            android:id="@+id/iv_prev_month"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_chevron_left"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                        <TextView
                            android:id="@+id/tv_current_month"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="4月 2026"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_next_month"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_chevron_right"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                    <!-- 日历视图 - huanghaibin CalendarView -->
                    <com.haibin.calendarview.CalendarView
                        android:id="@+id/calendar_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never"
                        android:clickable="true"
                        android:focusable="true"
                        app:month_view="com.main.ui.widget.CustomMonthView"
                        app:scheme_text_color="#FFFFFF"
                        app:day_text_size="14sp"
                        app:week_text_size="14sp" />

                    <!-- 标签文字 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="标签"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 浇水按钮组 - 各占一行 -->
                    <LinearLayout
                        android:id="@+id/ll_water_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 已浇水按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_water_done"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="已浇水"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_water"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 待浇水按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_water_pending"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:text="待浇水"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_not_water"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 取消标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_water"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="取消标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                        <!-- 打上标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirm_water"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="打上标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                    <!-- 施肥按钮组 - 各占一行 -->
                    <LinearLayout
                        android:id="@+id/ll_fertilize_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- 已施肥按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_fertilize_done"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="已施肥"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_manure"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 待施肥按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_fertilize_pending"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:text="待施肥"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_not_manure"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 取消标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_fertilize"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="取消标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                        <!-- 打上标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirm_fertilize"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="打上标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                    <!-- 用药按钮组 - 各占一行 -->
                    <LinearLayout
                        android:id="@+id/ll_medicine_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- 已用药按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_medicine_done"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="已用药"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_medicine"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 待用药按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_medicine_pending"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:text="待用药"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_not_medicine"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 取消标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_medicine"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="取消标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                        <!-- 打上标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirm_medicine"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="打上标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                    <!-- 笔记按钮组 - 各占一行 -->
                    <LinearLayout
                        android:id="@+id/ll_note_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- 有笔记按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_note_done"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="有笔记"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:backgroundTint="#E6E6E6"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_card_notebook"
                            app:iconGravity="textStart"
                            app:iconSize="18dp" />

                        <!-- 笔记输入框 -->
                        <EditText
                            android:id="@+id/et_note_content"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_note_input"
                            android:padding="12dp"
                            android:gravity="top|start"
                            android:hint="点击输入笔记内容"
                            android:textColorHint="#999999"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:inputType="textMultiLine" />

                        <!-- 取消标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_note"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="取消标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                        <!-- 打上标签按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirm_note"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="打上标签"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/bg_confirm_label"
                            app:backgroundTint="@null"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
