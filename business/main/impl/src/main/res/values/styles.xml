<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 日历日期文字样式 -->
    <style name="TextAppearance_PlantCalendar_Date" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/calendar_date_color</item>
    </style>

    <!-- 日历星期文字样式 -->
    <style name="TextAppearance_PlantCalendar_WeekDay" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/calendar_weekday_color</item>
    </style>

    <!-- 标签按钮样式 - 浇水 -->
    <style name="MarkButtonStyle.Water" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/mark_water</item>
        <item name="strokeColor">@color/mark_water</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 标签按钮样式 - 施肥 -->
    <style name="MarkButtonStyle.Fertilize" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/mark_fertilize</item>
        <item name="strokeColor">@color/mark_fertilize</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 标签按钮样式 - 用药 -->
    <style name="MarkButtonStyle.Medicine" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/mark_medicine</item>
        <item name="strokeColor">@color/mark_medicine</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 标签按钮样式 - 笔记 -->
    <style name="MarkButtonStyle.Note" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/mark_note</item>
        <item name="strokeColor">@color/mark_note</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="PlantInfoCard">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>
</resources>
