<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_main">

    <include
        android:id = "@+id/ai_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/base_detection_back">

    </include>
    <!-- 顶部标题栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="33dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">



        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI助手"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_ai_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 对话消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:background="@drawable/bg_ai_center"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- 底部输入区域 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_botton"
        android:elevation="8dp"
        android:padding="7dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 图片预览区域 -->
        <androidx.cardview.widget.CardView
         android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:id = "@+id/cv_img"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardCornerRadius="10dp"
            android:layout_marginLeft="10dp"
            app:layout_constraintBottom_toTopOf="@+id/cv_send"
            android:layout_marginBottom="5dp"
            app:cardElevation="1dp"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/rv_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:src="@drawable/bg_ai_botton"
                 />
                <ImageView
                    android:id="@+id/rv_noimages"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_margin="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintRight_toRightOf="@+id/rv_images"
                    app:layout_constraintTop_toTopOf="@+id/rv_images"
                    android:src="@drawable/ic_ai_cancel">

                </ImageView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id = "@+id/cv_send"
            app:layout_constraintTop_toBottomOf="@id/cv_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardElevation="0dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            app:cardCornerRadius="30dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:cardBackgroundColor="#99ffffff">
            <LinearLayout
                android:id="@+id/input_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                app:layout_constraintTop_toBottomOf="@id/rv_images">

                <!-- 添加图片按钮 -->
                <ImageView
                    android:id="@+id/btn_add_image"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:padding="7dp"
                    android:layout_marginLeft="7dp"
                    android:src="@drawable/ic_ai_takephoto"
                />

                <!-- 输入框 -->
                <EditText
                    android:id="@+id/et_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="请输入文本"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#999999"
                    android:textSize="15sp" />
                <ImageView
                    android:id="@+id/btn_yuyin"
                    android:layout_width="34dp"
                    android:layout_height="45dp"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_ai_yuyin"
                    />
                <ImageView
                    android:id="@+id/btn_xc"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:padding="9dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_ai_xc"
                    />
                <!-- 发送按钮 -->
                <ImageView
                    android:id="@+id/btn_send"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:padding="7dp"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_ai_send"
                    />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
