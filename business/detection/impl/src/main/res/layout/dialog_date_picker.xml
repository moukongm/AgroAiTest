<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_dialog_80_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:id="@+id/tv_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2024"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_right" />

    </LinearLayout>

    <!-- 月份网格（5列）- 预览用LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        tools:ignore="HardcodedStrings">

        <TextView
            android:id="@+id/tv_month_1"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="一月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp"
             />

        <TextView
            android:id="@+id/tv_month_2"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="二月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_3"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="三月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_4"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="四月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_5"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="五月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 月份网格第2行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        tools:ignore="HardcodedStrings">

        <TextView
            android:id="@+id/tv_month_6"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="六月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_7"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="七月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_8"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="八月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_9"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="九月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_10"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="十月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 月份网格第3行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        tools:ignore="HardcodedStrings">

        <TextView
            android:id="@+id/tv_month_11"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="十一月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_month_12"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/month_item_bg_selector"
            android:gravity="center"
            android:text="十二月"
            android:textColor="@color/month_text_selector"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:visibility="invisible" />

        <View
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- 真正的RecyclerView（实际运行时使用，生产时注释掉） -->
    <!--
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        />
    -->

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tv_confirm"
            android:layout_width="60dp"
            android:layout_height="25dp"
            android:src="@drawable/img"
            android:gravity="center"
            android:text="确认"
            android:textColor="#FFFFFF"
            android:textSize="14sp">

        </ImageView>
        <ImageView
            android:id="@+id/tv_cancel"
            android:layout_marginTop="1dp"
            android:layout_width="65dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_rili_tvcancle"
            android:gravity="center"
            android:text="取消"
            android:textColor="#FF7A00"
            android:textSize="14sp" >

        </ImageView>


    </LinearLayout>

</LinearLayout>